[preset00]
MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
fDecay=0.9
warp=0
nWaveMode=2
bAdditiveWaves=1
bWaveThick=1
bMaximizeWaveColor=1
fWaveAlpha=1
fWaveScale=4
fWaveSmoothing=0.9
wave_r=1
wave_g=1
wave_b=1
wave_x=0.5
wave_y=0.5
ob_a=0
ib_a=0

// Centered spiro wave, which reads smoothed samples kept from the previous frame: a preload warm-up
// frame that left its audio in the waveform changes the first frame. The composite shader replaces
// the default one, whose hue shading uses per-preset random values.
comp_1=`shader_body
comp_2=`{
comp_3=`ret = tex2D(sampler_main, uv).xyz;
comp_4=`}
