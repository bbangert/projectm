[preset00]
MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
fDecay=0.98
bTexWrap=0
wave_a=1

// The main texture with all four wrap/filter combinations in one draw, in both shaders. The image
// must not depend on whether the ES 2 backend has sampler objects.
warp_1=`shader_body
warp_2=`{
warp_3=`float2 st = uv * 1.3 - 0.15 + texsize.zw * 0.5;
warp_4=`ret = tex2D(sampler_main, uv).xyz * 0.9;
warp_5=`ret += 0.1 * tex2D(sampler_pw_main, st).xyz;
warp_6=`ret -= 0.05 * tex2D(sampler_fc_main, st).xyz;
warp_7=`}
comp_1=`shader_body
comp_2=`{
comp_3=`float2 st = uv * 1.5 - 0.25 + texsize.zw * 0.5;
comp_4=`ret = tex2D(sampler_pc_main, st).xyz * 0.5 + tex2D(sampler_fw_main, st).xyz * 0.5;
comp_5=`ret += abs(tex2D(sampler_pw_main, st).xyz - tex2D(sampler_fc_main, st).xyz) * 4;
comp_6=`}
