[preset00]
MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
bInvert=1
fWaveAlpha=0
ob_a=0
ib_a=0

// A black image with an inverting composite shader and bInvert: white either through the
// composite shader or, if that fails, the classic composite with the invert filter.
warp_1=`shader_body
warp_2=`{
warp_3=`ret = 0;
warp_4=`}
comp_1=`shader_body
comp_2=`{
comp_3=`ret = 1 - tex2D(sampler_main, uv).xyz;
comp_4=`}
