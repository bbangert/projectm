[preset00]
MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
fDecay=0.98
wave_a=1

// Warp and composite shaders: 2D and 3D noise, blur1 and the previous frame.
warp_1=`shader_body
warp_2=`{
warp_3=`ret = tex2D(sampler_main, uv).xyz * 0.97;
warp_4=`ret += (tex2D(sampler_noise_lq, uv + rand_frame.xy).xyz - 0.5) * 0.05;
warp_5=`}
comp_1=`shader_body
comp_2=`{
comp_3=`float3 noise = tex3D(sampler_noisevol_lq, float3(uv, time * 0.1)).xyz;
comp_4=`ret = lerp(tex2D(sampler_main, uv).xyz, GetBlur1(uv), 0.5) + noise * 0.5;
comp_5=`}
