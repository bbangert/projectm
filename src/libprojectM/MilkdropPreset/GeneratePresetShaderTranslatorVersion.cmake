cmake_minimum_required(VERSION 3.20 FATAL_ERROR)

# Run in script mode when a translator source changes. Writes PresetShaderTranslatorVersion.hpp
# with a hash over the translator sources, which is part of every preset shader cache key.
#
# Inputs: SOURCE_DIR (paths are hashed relative to it), SOURCES (list), OUTPUT_FILE.

set(_version_input "")
set(_sources ${SOURCES})
list(SORT _sources)
foreach(_source IN LISTS _sources)
    file(SHA256 "${_source}" _source_hash)
    file(RELATIVE_PATH _relative_path "${SOURCE_DIR}" "${_source}")
    string(APPEND _version_input "${_relative_path} ${_source_hash}\n")
endforeach()
string(SHA256 _version "${_version_input}")

set(_contents "#pragma once\n\n// Generated by GeneratePresetShaderTranslatorVersion.cmake, do not edit.\n#define PROJECTM_PRESET_SHADER_TRANSLATOR_VERSION \"${_version}\"\n")

file(WRITE "${OUTPUT_FILE}" "${_contents}")
